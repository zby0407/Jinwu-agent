{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b3.local/specs/hypothesis_portfolio_v2.schema.json",
  "title": "B3 HypothesisPortfolio 1.0",
  "description": "Evidence-grounded, lineage-preserving portfolio of testable solar-cycle hypotheses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "portfolio_id",
    "created_at",
    "status",
    "claim_boundary",
    "source_ids",
    "artifact_paths",
    "experiment_ids",
    "hypotheses",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "b3-hypothesis-portfolio-v2"
    },
    "run_id": {
      "$ref": "#/$defs/stableId"
    },
    "portfolio_id": {
      "$ref": "#/$defs/stableId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "needs_revision",
        "calibrated",
        "rejected"
      ]
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    },
    "source_ids": {
      "description": "In-document catalog of source ids accepted by evidence references.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "artifact_paths": {
      "description": "In-document catalog of immutable artifact paths accepted by evidence references.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "experiment_ids": {
      "description": "In-document catalog of registered experiment ids accepted by predictions.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/registeredExperimentId"
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hypothesisCard"
      }
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^/\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registeredExperimentId": {
      "enum": [
        "E0_data_vintage_audit",
        "E1_cycle_segmentation_baseline",
        "E2_waldmeier_leave_one_cycle_out",
        "E3_f107_phase_stratified_drift",
        "E4_extended_hemispheric_calibration",
        "E5_polar_precursor_robustness",
        "E6_low_order_dynamo_family_ablation",
        "E7_negative_controls_and_placebos",
        "E8_clean_reproduction"
      ]
    },
    "claimBoundary": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "forbidden"
          ],
          "properties": {
            "allowed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "forbidden": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "hypothesisCard": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "generation_strategy": {
                "enum": [
                  "grounding",
                  "simplification",
                  "combination",
                  "divergence"
                ]
              }
            },
            "required": [
              "generation_strategy"
            ]
          },
          "then": {
            "properties": {
              "lineage": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "version",
        "lineage",
        "generation_strategy",
        "hypothesis",
        "mechanism_graph",
        "measurable_predictions",
        "supporting_evidence",
        "counter_evidence",
        "falsifiers",
        "confounders",
        "alternatives",
        "novelty",
        "claim_boundary",
        "decision",
        "next_test"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "lineage": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "generation_strategy": {
          "enum": [
            "mechanism_driven",
            "anomaly_driven",
            "competitive_explanation",
            "counterfactual_simplification",
            "grounding",
            "simplification",
            "combination",
            "divergence"
          ]
        },
        "hypothesis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mechanism_graph": {
          "$ref": "#/$defs/mechanismGraph"
        },
        "measurable_predictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prediction"
          }
        },
        "supporting_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "counter_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "confounders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "novelty": {
          "$ref": "#/$defs/novelty"
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "tournament": {
          "$ref": "#/$defs/tournament"
        },
        "claim_boundary": {
          "$ref": "#/$defs/claimBoundary"
        },
        "decision": {
          "enum": [
            "retain",
            "revise",
            "discard",
            "downgrade"
          ]
        },
        "next_test": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "mechanismGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mechanismNode"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mechanismEdge"
          }
        }
      }
    },
    "mechanismNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "layer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "layer": {
          "enum": [
            "measurement",
            "observation",
            "proxy",
            "physical_mechanism",
            "latent"
          ]
        }
      }
    },
    "mechanismEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "relation"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/stableId"
        },
        "target": {
          "$ref": "#/$defs/stableId"
        },
        "relation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "direction",
        "threshold_or_interval",
        "time_window",
        "target_experiment"
      ],
      "properties": {
        "variable": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease",
            "no_change",
            "non_monotonic",
            "bounded"
          ]
        },
        "threshold_or_interval": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "time_window": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_experiment": {
          "$ref": "#/$defs/registeredExperimentId"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "artifact"
          ]
        },
        "ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "verified",
            "passed",
            "warning",
            "failed",
            "quarantined",
            "inconclusive"
          ]
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nearest_work",
        "similarity",
        "difference",
        "status"
      ],
      "properties": {
        "nearest_work": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "similarity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "difference": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "known",
            "incremental",
            "uncertain",
            "potentially_novel"
          ]
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_grounding",
        "mechanism_coherence",
        "testability",
        "falsifiability",
        "novelty",
        "reproducibility",
        "uncertainty"
      ],
      "properties": {
        "data_grounding": {
          "$ref": "#/$defs/score"
        },
        "mechanism_coherence": {
          "$ref": "#/$defs/score"
        },
        "testability": {
          "$ref": "#/$defs/score"
        },
        "falsifiability": {
          "$ref": "#/$defs/score"
        },
        "novelty": {
          "$ref": "#/$defs/score"
        },
        "reproducibility": {
          "$ref": "#/$defs/score"
        },
        "uncertainty": {
          "description": "Quality of uncertainty characterization and calibration; higher is better, not the raw magnitude of uncertainty.",
          "$ref": "#/$defs/score"
        }
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tournament": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "position_bias"
      ],
      "properties": {
        "rating": {
          "type": "number"
        },
        "position_bias": {
          "type": "boolean"
        },
        "match_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    }
  }
}
