{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b3.local/specs/research_plan_v2.schema.json",
  "title": "B3 ResearchPlan 1.0",
  "description": "Frozen, falsifiable research plan handed from the planner to registered experiment tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "research_question",
    "claim_boundary",
    "data_contracts",
    "task_graph",
    "primary_metrics",
    "counter_evidence_paths",
    "stop_rules",
    "frozen_hash",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "b3-research-plan-v2"
    },
    "run_id": {
      "$ref": "#/$defs/stableId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "frozen",
        "needs_revision"
      ]
    },
    "research_question": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "claim_boundary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "data_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataContract"
      }
    },
    "task_graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taskNode"
      }
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "counter_evidence_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "frozen_hash": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^/\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "version",
        "license",
        "time_coverage",
        "available_at",
        "semantic_layer",
        "data_status",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "time_coverage": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "available_at": {
          "description": "When the feature or observation becomes causally available at a forecast origin.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "semantic_layer": {
          "enum": [
            "observation",
            "reconstruction",
            "proxy",
            "mechanism"
          ]
        },
        "data_status": {
          "enum": [
            "provisional",
            "definitive",
            "retrospective"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "taskNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "depends_on",
        "inputs",
        "outputs",
        "tool",
        "seed",
        "budget",
        "success_criteria",
        "failure_strategy",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "data_audit",
            "baseline",
            "experiment",
            "negative_control",
            "ablation",
            "replication",
            "review"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "tool": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_seconds": {
              "type": "number",
              "minimum": 0
            },
            "cpu_seconds": {
              "type": "number",
              "minimum": 0
            },
            "gpu_seconds": {
              "type": "number",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "failure_strategy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "planned",
            "ready",
            "running",
            "completed",
            "failed",
            "blocked",
            "skipped"
          ]
        },
        "split_strategy": {
          "enum": [
            "expanding_window",
            "leave_one_cycle_out",
            "rolling_origin",
            "not_applicable"
          ]
        }
      }
    }
  }
}
