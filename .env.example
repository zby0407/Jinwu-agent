# JW — cp .env.example .env && fill in your keys

# LLM provider (pick at least one)
ANTHROPIC_API_KEY=           # console.anthropic.com
OPENAI_API_KEY=              # platform.openai.com
GOOGLE_API_KEY=              # aistudio.google.com/api-keys
NVIDIA_API_KEY=              # build.nvidia.com

# Direct providers (optional)
MINIMAX_API_KEY=              # platform.minimaxi.com (China, default) or platform.minimax.io (Global)
MINIMAX_BASE_URL=             # https://api.minimaxi.com/anthropic (default) or https://api.minimax.io/anthropic
ZHIPU_API_KEY=                # open.bigmodel.cn (智谱)
VOLCENGINE_API_KEY=           # volcengine.com (火山引擎)
DASHSCOPE_API_KEY=            # dashscope.aliyuncs.com (阿里云)
MOONSHOT_API_KEY=             # platform.moonshot.cn (月之暗面)
KIMI_API_KEY=                 # kimi.com/code (Kimi 代码计划)

# Aggregator platforms (optional)
SILICONFLOW_API_KEY=          # siliconflow.cn
OPENROUTER_API_KEY=           # openrouter.ai

# Custom endpoints (optional)
CUSTOM_OPENAI_API_KEY=       # OpenAI-compatible endpoint
CUSTOM_OPENAI_BASE_URL=
CUSTOM_ANTHROPIC_API_KEY=    # Anthropic-compatible endpoint
CUSTOM_ANTHROPIC_BASE_URL=

# Local models (optional)
OLLAMA_BASE_URL=              # http://localhost:11434 (default)

# Web search (optional)
TAVILY_API_KEY=              # app.tavily.com

# LLM Wiki literature sources (optional; provider failures degrade to partial)
ADS_API_TOKEN=               # ui.adsabs.harvard.edu/user/settings/token
OPENALEX_API_KEY=            # openalex.org/settings/api
CROSSREF_MAILTO=             # contact email for Crossref polite-pool requests

# Runtime locations (optional)
# Source-checkout default: ./workspace
JW_WORKSPACE_DIR=
# Global SQLite state such as sessions.db and knowledge.db (default: ~/.jw)
JW_DATA_DIR=
# Markdown knowledge export (default: <workspace>/knowledge_base)
JW_KB_EXPORT_DIR=

# Integrated research review 2.0 (optional)
# adaptive: no fixed round count, but no-progress and total-review budgets stop it.
# fixed: use JW_RESEARCH_MAX_REVISIONS (the frozen comparison default is 3).
# Auxiliary settings are reserved for lightweight routing and background work;
# Evidence review remains the scientific routing authority.
JW_AUXILIARY_PROVIDER=
JW_AUXILIARY_MODEL=
# Healthy Qwen research streams can pause between chunks for more than the
# generic LangChain 120s default. This watchdog remains finite (30..900s).
JW_DASHSCOPE_STREAM_CHUNK_TIMEOUT_S=300
# One DashScope request attempt is bounded separately from idle chunks. SDK
# retries are off by default so retry/fallback remains visible to the research
# state machine instead of multiplying a long review call invisibly.
JW_DASHSCOPE_REQUEST_TIMEOUT_S=300
JW_DASHSCOPE_MAX_RETRIES=0
# Qwen3 thinking is bounded by phase; structured/forced tool calls disable it.
JW_QWEN_THINKING_BUDGET=4096
JW_QWEN_PLANNING_THINKING_BUDGET=3072
JW_QWEN_DATA_THINKING_BUDGET=4096
JW_QWEN_PRODUCER_THINKING_BUDGET=6144
JW_QWEN_REVIEW_THINKING_BUDGET=8192
JW_RESEARCH_REVISION_POLICY=adaptive
JW_RESEARCH_MAX_REVISIONS=
JW_RESEARCH_NO_PROGRESS_PATIENCE=2
JW_RESEARCH_BUDGET_MULTIPLIER=5
