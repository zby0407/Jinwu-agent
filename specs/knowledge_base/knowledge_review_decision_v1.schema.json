{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-review-decision-v1",
  "title": "Knowledge Base Review Decision 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue_id", "decision"],
  "properties": {
    "queue_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Review queue row id returned by kb_promote (pending) or kb_conflicts."
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected"]
    },
    "note": {"type": "string", "maxLength": 2000},
    "reviewer": {"type": "string", "default": "human", "maxLength": 200}
  }
}
