{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b3.local/specs/experiment_manifest_v2.schema.json",
  "title": "B3 ExperimentManifest 1.0",
  "description": "Immutable accounting record for one registered experiment node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "node_id",
    "parent_id",
    "experiment_id",
    "seed",
    "status",
    "started_at",
    "finished_at",
    "data_sources",
    "artifacts",
    "result",
    "error",
    "claim_effect",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "b3-experiment-manifest-v2"
    },
    "run_id": {
      "$ref": "#/$defs/stableId"
    },
    "node_id": {
      "$ref": "#/$defs/stableId"
    },
    "parent_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "experiment_id": {
      "$ref": "#/$defs/stableId"
    },
    "plan_revision": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "phase": {
      "enum": [
        "draft",
        "debug",
        "improve",
        "replicate",
        "ablate",
        "clean_reproduction"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "warning",
        "failed",
        "quarantined",
        "inconclusive"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "hypothesis": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "expected_direction": {
      "enum": [
        "increase",
        "decrease",
        "no_change",
        "non_monotonic",
        "bounded"
      ]
    },
    "falsifier": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "secondary_metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "atomic_change": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataSource"
      }
    },
    "split_hashes": {
      "$ref": "#/$defs/splitHashes"
    },
    "feature_availability_audit": {
      "$ref": "#/$defs/gate"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/gate"
        },
        "stability": {
          "$ref": "#/$defs/gate"
        },
        "leakage": {
          "$ref": "#/$defs/gate"
        },
        "safety": {
          "$ref": "#/$defs/gate"
        },
        "reproduction": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "result": {
      "description": "Registered experiments have heterogeneous deterministic result fields; the immutable envelope and hashes remain closed and authoritative.",
      "type": "object"
    },
    "provenance": {
      "description": "Methodology declarations retained for leakage audit and failure accounting.",
      "type": "object"
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "failed",
        "inconclusive"
      ]
    },
    "claim_effect": {
      "enum": [
        "supports_bounded_claim",
        "keeps_confidence_bounded",
        "lowers_confidence",
        "blocks_claim"
      ]
    },
    "retention_reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "not": {"const": "failed"}
          }
        }
      },
      "then": {
        "properties": {
          "data_sources": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^/\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "license",
        "retrieved_at",
        "available_at",
        "sha256",
        "data_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "data_status": {
          "enum": [
            "provisional",
            "definitive",
            "retrospective"
          ]
        }
      }
    },
    "splitHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "train_sha256",
        "validation_sha256",
        "test_sha256"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "expanding_window",
            "leave_one_cycle_out",
            "rolling_origin"
          ]
        },
        "train_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "test_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "cwd",
        "code_sha256",
        "dependency_lock_sha256",
        "python_version",
        "os",
        "hardware"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cwd": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "hardware": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "cpu_seconds",
        "gpu_seconds",
        "peak_ram_mb",
        "tokens"
      ],
      "properties": {
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "gpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak_ram_mb": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "stdout",
            "stderr",
            "predictions",
            "metrics",
            "table",
            "figure",
            "checkpoint",
            "other"
          ]
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "warning",
            "failed",
            "not_run"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
