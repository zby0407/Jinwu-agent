{
  "openapi": "3.0.3",
  "info": {
    "title": "Solar-Cycle Co-Scientist API",
    "version": "0.5.0",
    "description": "Direction 2B3 solar-cycle origin exploration API with deterministic analysis, auditable iteration_trace, and optional Qwen/Bailian language critique."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8777",
      "description": "Local evaluation server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/api/model/status": {
      "get": {
        "summary": "Qwen/Bailian adapter status",
        "responses": {
          "200": {
            "description": "Model routing status without exposing credentials"
          }
        }
      }
    },
    "/api/datasets": {
      "get": {
        "summary": "Dataset catalog and coverage",
        "responses": {
          "200": {
            "description": "Primary data, derived products, and supporting materials"
          }
        }
      }
    },
    "/api/analysis": {
      "get": {
        "summary": "Unified B3 analysis report",
        "parameters": [
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Analysis report with cycle features, WSO precursor, toy model, hypotheses, and tournament ranking"
          }
        }
      }
    },
    "/api/readiness-report": {
      "get": {
        "summary": "Submission readiness report",
        "responses": {
          "200": {
            "description": "Package checks and metrics"
          }
        }
      }
    },
    "/api/evidence": {
      "get": {
        "summary": "Literature and source evidence catalog",
        "responses": {
          "200": {
            "description": "Search protocol, sources, and hypothesis evidence links"
          }
        }
      }
    },
    "/api/evidence/{hypothesis_id}": {
      "get": {
        "summary": "Evidence links for a hypothesis",
        "parameters": [
          {
            "name": "hypothesis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sources, support level, counter-evidence, and next validation for one hypothesis"
          }
        }
      }
    },
    "/api/evidence/query": {
      "post": {
        "summary": "Keyword query over the evidence matrix",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked evidence sources"
          }
        }
      }
    },
    "/api/research/run": {
      "post": {
        "summary": "Create a research run",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Research run with plan, iteration_trace, experiments, hypotheses, model_assist, and report"
          }
        }
      }
    },
    "/api/research": {
      "get": {
        "summary": "List recent research runs",
        "responses": {
          "200": {
            "description": "Recent run metadata"
          }
        }
      }
    },
    "/api/research/{run_id}": {
      "get": {
        "summary": "Get a research run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full research run"
          }
        }
      }
    },
    "/api/research/{run_id}/experiments": {
      "get": {
        "summary": "Get experiment log for a run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experiment records"
          }
        }
      }
    },
    "/api/research/{run_id}/hypotheses": {
      "get": {
        "summary": "Get hypothesis cards for a run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hypothesis cards"
          }
        }
      }
    },
    "/api/research/{run_id}/report": {
      "get": {
        "summary": "Get report for a run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["json", "md"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON or Markdown report"
          }
        }
      }
    },
    "/api/hypotheses/review": {
      "post": {
        "summary": "Review a user-provided hypothesis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HypothesisReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nearest supported hypothesis and required improvements"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResearchRunRequest": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "enum": ["cycle26_prediction", "dynamo_mechanism_review", "proxy_drift_analysis"]
          },
          "data_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agent_mode": {
            "type": "string"
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      },
      "HypothesisReviewRequest": {
        "type": "object",
        "required": ["hypothesis"],
        "properties": {
          "hypothesis": {
            "type": "string"
          }
        }
      },
      "EvidenceQueryRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "IterationTraceItem": {
        "type": "object",
        "properties": {
          "iteration": {
            "type": "integer"
          },
          "phase": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["completed", "planned"]
          },
          "trigger": {
            "type": "string"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_added": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_before": {
            "type": "number"
          },
          "confidence_after": {
            "type": "number",
            "nullable": true
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    }
  }
}
