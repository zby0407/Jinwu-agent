    {"id": "FR-H10", "focus": ["independent_sample_count", "small_sample", "evidence_limit_preservation"]},
    {"id": "FR-H12", "focus": ["integration_claim_diff", "unsupported_causality", "unsupported_interval"]},
    {"id": "SC26-B03", "focus": ["measurement_drift", "physical_change", "source_quality"]},
    {"id": "SC26-B05", "focus": ["direct_measurement", "small_sample_precursor", "insufficient_evidence"]},
