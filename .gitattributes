# Registered research inputs are hash-bound byte snapshots. Never normalize
# their line endings, otherwise catalog SHA-256 verification becomes platform-dependent.
/projects/default/shared/data/** binary
# Frozen scientific modules carry source hashes; preserve their original bytes.
/jw/flare_forecast/_frozen/** -text whitespace=cr-at-eol
# Windows checkouts pass this runner directly to Linux bash.
/src/automatic_experiment/sandbox_runner.sh text eol=lf
